# Session Browser configuration. Copy to config.toml and edit.
# Paths use ~ for the home directory; they are expanded at load time.

[paths]
db          = "~/.session-browser/registry.db"
facets_dir  = "~/.session-browser/facets"
hook_state  = "~/.session-browser/.hook-state.json"
log_dir     = "~/.session-browser/logs"

[ui]
host             = "127.0.0.1"
port             = 7655
default_filter   = "all"
bridge_max_chars = 3000
show_onboarding  = "auto"

# --- Sources -----------------------------------------------------------------
# Each enabled source maps to an adapter in sources/. Adding a new CLI
# (opencode, ollama, codex, ...) is a new sources/<name>.py + a block here.

[sources.claude]
enabled      = true
projects_dir = "~/.claude/projects"
binary       = "claude"

[sources.copilot]
enabled   = true
state_dir = "~/.copilot/session-state"
binary    = "copilot"

[sources.codex]
enabled      = true
sessions_dir = "~/.codex/sessions"
# `codex archive` MOVES a rollout into this sibling tree. Indexed and watched
# alongside sessions_dir so archiving in Codex does not erase the work here.
# Defaults to <sessions_dir>/../archived_sessions when omitted.
archived_sessions_dir = "~/.codex/archived_sessions"
binary       = "codex"

[sources.opencode]
enabled    = true
# OpenCode keeps every session in ONE SQLite DB (WAL). It is read read-only and
# projected to one JSONL per ROOT session (sub-agent children embedded, their
# cost rolled up) under mirror_dir — the mirror is what the watcher, archive,
# restore and search operate on, and it doubles as the backup.
# DB resolution: $OPENCODE_DB > `db` > <data_dir>/opencode.db > newest opencode-<channel>.db
data_dir   = "~/.local/share/opencode"     # honours $XDG_DATA_HOME when unset here
# db       = "~/.local/share/opencode/opencode-beta.db"
mirror_dir = "~/.session-browser/opencode-mirror"
reimport_on_restore = true                 # Restore also runs `opencode import`
binary     = "opencode"

# --- Enrichment --------------------------------------------------------------
[enrichment]
provider = "claude-headless"   # claude-headless | copilot-headless | none

[enrichment.claude_headless]
binary          = "claude"
# Model for journal enrichment. Pinned (not the CLI's default model) so spend
# stays predictable — on API billing, Sonnet runs ~$0.05-0.08 per session vs
# ~5x that on Opus-tier defaults. Set to "" to use the CLI's default model.
model           = "claude-sonnet-5"
exec_args       = ["--print"]
prompt_template = "summarize-multi-source.md"
timeout_secs    = 180

# --- Daily digest --------------------------------------------------------------
# The nightly refresh assembles daily-logs/YYYY-MM-DD.md from enriched sessions
# (deterministic — no LLM call). Self-healing: any past day whose file is
# missing or stale is (re)written on the next run.
[digest]
daily_dir = "~/.session-browser/daily-logs"

# --- Reports (work-journal skill) ----------------------------------------------
# Where generated summaries/timelines land, and an OPTIONAL personal style file
# layered over the skill's default report structure (keeps company-specific
# performance-review framing out of this repo). The override file need not exist.
[reports]
out_dir        = "~/.session-browser/reports"
style_override = "~/.session-browser/report-style.md"

# --- Reasoning archive (headline feature) ------------------------------------
# Raw transcripts and rendered "thinking -> decision -> action" trails are
# written under archive_dir/{raw,readable}/YYYY/MM/.
[reasoning]
enabled     = true
archive_dir = "~/claude-reasoning-archive"

# --- Billing -----------------------------------------------------------------
# Most users are on a flat-rate subscription, NOT per-token API billing. In
# "subscription" mode the per-session dollar figure is treated as a NOTIONAL
# API-equivalent (what it *would* cost on the API) — useful as a usage/intensity
# signal, but you are not billed per token. Set mode="api" if you actually pay
# per token.
[billing]
mode        = "subscription"   # subscription | api
plan        = "Claude Max 5x"
monthly_usd = 100              # flat monthly price of the plan (for context)

# --- Embeddings / semantic search --------------------------------------------
# Default backend is numpy brute-force cosine over BLOB embeddings (no native
# extension needed; fast for up to a few thousand sessions). If sqlite-vec is
# loadable in the active interpreter it is used as an optional fast path.
[embeddings]
model   = "all-MiniLM-L6-v2"
backend = "auto"   # auto | numpy | sqlite-vec
